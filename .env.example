# =============================================================================
# 涨停回调低吸战法 —— 部署环境变量模板
# 用法：复制为项目根目录的 .env 后按需修改，deploy.sh / deploy.ps1 会自动处理。
#      cp .env.example .env
# 注意：本文件不得提交任何真实密钥；.env 已在 .gitignore 中忽略。
# =============================================================================

# ----------------------------- 服务与端口 -----------------------------
# 宿主机对外暴露端口（云服务器安全组需放行该端口）
HOST_PORT=8000
# 容器内应用监听端口（通常无需修改）
APP_PORT=8000

# ----------------------------- 镜像标识 -------------------------------
IMAGE_NAME=limit-up-pullback
IMAGE_TAG=latest
CONTAINER_NAME=limit-up-app

# ----------------------------- 数据源配置 -----------------------------
# auto      = 按 DATA_SOURCE_ORDER 依次尝试真实行情源，全部不可用才降级为演示数据（推荐）
# real      = 同上但【绝不降级】，全部真实源失败即报错（生产环境推荐，可及早发现数据源故障）
# eastmoney = 强制只使用东方财富
# tencent   = 强制只使用腾讯财经
# sina      = 强制只使用新浪财经
# synthetic = 强制使用内置合成演示数据，完全离线可用
DATA_SOURCE_MODE=auto

# 真实数据源优先级（逗号分隔）。故障转移按此顺序尝试；
# 出现连续失败的源会进入指数退避冷却并被跳过，冷却结束后自动恢复参与。
# 说明：东方财富的全市场股票列表接口字段最全，故默认排第一；
#      若所在网络阻断该域名（企业出口/部分云机房），会自动落到腾讯或新浪，无需人工干预。
DATA_SOURCE_ORDER=eastmoney,tencent,ths,sina

# ----------------------------- 刷新策略 -------------------------------
# 开盘期间（09:30-11:30 / 13:00-15:00）的刷新间隔（秒）。
# 后端缓存 TTL 与前端自动轮询间隔都取此值，即「开盘期间每 30 秒刷新」。
# 非开盘时段自动放宽到 CACHE_TTL_SECONDS，收盘后前端停止轮询。
REFRESH_INTERVAL_SECONDS=30

# 非开盘时段的行情缓存有效期（秒）
CACHE_TTL_SECONDS=300

# ----------------------------- 股票池覆盖范围 -----------------------------
# 0 = 【不限量，覆盖全部 A 股】（默认）。对应用户要求：
#     「主板、创业板、科创板、北交所等所有交易所的股票都不能遗漏」。
#     实测全市场约 5,500 只（主板约 3,200 / 创业板约 1,400 / 科创板约 620 / 北交所约 340）。
#     首轮全量拉取在 24 并发下约 3~5 分钟（一次性，之后走增量缓存）。
# 设为正整数 N 时只监控 N 只，并按「板块轮转」截取，
# 保证截取结果里主板/创业板/科创板/北交所都仍有代表，不会整块缺失。
UNIVERSE_SIZE=0

# 合成演示数据的股票数量（与真实股票池规模无关，仅 DATA_SOURCE_MODE=synthetic 或降级时生效）
SYNTHETIC_UNIVERSE_SIZE=300

# ----------------------------- 性能与缓存 -----------------------------
# 单只股票日线缓存保留的最大根数（控制 SQLite 库体积）
KLINE_CACHE_MAX_DAYS=400
# 股票列表、实时行情等轻量请求的并发数
SOURCE_CONCURRENCY=12
# 日线批量抓取的并发数。全市场约 5500 只，建议 16~24；
# 过高会触发新浪反爬（HTTP 456，封禁约 10 分钟）。
KLINE_CONCURRENCY=24
# 上游行情接口超时（秒）。东方财富在受限网络下会被快速失败并由其他源接管。
HTTP_TIMEOUT=10
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 时区
TZ=Asia/Shanghai

# ----------------------------- 开发态跨域（生产可留空）-----------------
# 仅本地 Vite 开发服务器需要；生产由后端同源提供前端，无需配置
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------- 构建期镜像源（国内服务器必看）-----------------
# 实测国内服务器直连 PyPI 只有约 18 KB/s：下载 numpy（16.7 MB）耗时 18 分钟、
# pandas（11 MB）直接读超时导致构建失败（报 exit code 2）。
# 因此默认**全程使用国内镜像**，不依赖任何境外源：
#   主源   清华 TUNA   （实测响应 2.0s）
#   备用源 中科大 USTC （实测响应 1.4s，与主源互为容灾）
# 海外服务器请改为官方源：
#   PIP_INDEX_URL=https://pypi.org/simple
#   PIP_EXTRA_INDEX_URL=
#   NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_EXTRA_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

# 可选的其它国内 PyPI 镜像（按需替换上面的值）：
#   阿里云      https://mirrors.aliyun.com/pypi/simple/
#   腾讯云      https://mirrors.cloud.tencent.com/pypi/simple/
#   华为云      https://repo.huaweicloud.com/repository/pypi/simple/

# ----------------------------- 可选：HTTPS 自动证书 --------------------
# 启用方式：./deploy.sh --https   （或 docker compose --profile https up -d）
# 留空 DOMAIN 时，Caddy 仅提供 HTTP 反向代理
DOMAIN=
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
