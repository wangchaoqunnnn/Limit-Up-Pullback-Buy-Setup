# =============================================================================
# 涨停回调低吸战法 —— 后端环境变量模板
# 用法：复制为 backend/.env 后按需修改。所有值均有合理默认，离线可直接运行。
# 说明：项目根目录还有一份 .env.example（供 Docker Compose 使用），字段含义一致。
# =============================================================================

# ----------------------------- 服务与端口 -----------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# ----------------------------- 数据源配置 -----------------------------
# auto      = 按 DATA_SOURCE_ORDER 依次尝试真实行情源，全部不可用才降级演示数据（推荐）
# real      = 同上但绝不降级，全部真实源失败即报错（生产推荐）
# eastmoney / tencent / ths / sina / yahoo = 强制只使用指定单一源
# synthetic = 强制使用内置合成演示数据，完全离线可用
DATA_SOURCE_MODE=auto

# 真实数据源优先级（逗号分隔）。故障转移按此顺序尝试；
# 连续失败的源会进入指数退避冷却（3s→6s→12s…上限 120s）并被跳过，冷却后自动恢复。
# 从未成功过的源（如域名被网络阻断）失败后长期跳过，避免每个请求白等一个超时。
# 末位 yahoo（雅虎财经）是完全独立的境外源，仅在前四个国内源全部失效时兜底；
# 它不提供北交所与全市场列表，只补主板/创业板/科创板日线与指数。
DATA_SOURCE_ORDER=eastmoney,tencent,ths,sina,yahoo

# 数据目录（相对路径，基于 backend/ 推导；留空则使用 backend/data）
DATA_DIR=

# ----------------------------- 刷新策略 -----------------------------
# 开盘期间（09:30-11:30 / 13:00-15:00）的刷新间隔（秒）。
# 后端缓存 TTL 与前端自动轮询间隔都取此值。
REFRESH_INTERVAL_SECONDS=30
# 非开盘时段的行情缓存有效期（秒）
CACHE_TTL_SECONDS=300

# ----------------------------- 股票池覆盖范围 -----------------------------
# 0 = 【不限量，覆盖全部 A 股】（默认）。
#     实测全市场约 5,500 只：主板约 3,200 / 创业板约 1,400 / 科创板约 620 / 北交所约 340。
#     首轮全量拉取在 24 并发下约 3~5 分钟（一次性，之后走增量缓存）。
# 设为正整数 N 时只监控 N 只，并按「板块轮转」截取，
# 保证主板/创业板/科创板/北交所都仍有代表，不会整块缺失。
UNIVERSE_SIZE=0
# 合成演示数据的股票数量（与真实股票池规模独立）
SYNTHETIC_UNIVERSE_SIZE=300

# ----------------------------- 性能与缓存 -----------------------------
# 单只股票日线缓存保留的最大根数（控制 SQLite 库体积）
KLINE_CACHE_MAX_DAYS=400
# 股票列表、实时行情等轻量请求的并发数
SOURCE_CONCURRENCY=12
# 日线批量抓取的并发数。全市场约 5500 只，建议 16~24；
# 过高会触发新浪反爬（HTTP 456，封禁约 10 分钟）。
KLINE_CONCURRENCY=24
# 上游行情接口超时（秒）。东方财富在受限网络下会被快速失败并由其他源接管。
HTTP_TIMEOUT=10

# ----------------------------- 其他 -----------------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 时区
TZ=Asia/Shanghai

# ----------------------------- 开发态跨域（生产可留空）-----------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
